# 运行环境：development / test / production
ENVIRONMENT=development

# OpenAI API Key
OPENAI_API_KEY=sk-replace-me

# API 代理地址（可选，默认为 OpenAI 官方地址）
OPENAI_BASE_URL=https://api.openai.com/v1

# 模型配置
MODEL_NAME=gpt-4o-mini
TEMPERATURE=0.7
MODEL_TIMEOUT_SECONDS=30
MODEL_MAX_RETRIES=2
MODEL_RETRY_BASE_SECONDS=0.2
MODEL_REQUESTS_PER_MINUTE=60
AGENT_STRATEGY=react
MAX_PLAN_STEPS=6
PLAN_MAX_CONCURRENCY=3
PLAN_TTL_SECONDS=900
PLAN_MAX_RESUME_COUNT=3

# 第 23 期：具体业务提案的确认有效期（秒），与计划 TTL 分开管理
ACTION_CONFIRMATION_TTL_SECONDS=900

# 阶段 22：计划运行时治理
PLAN_WORKER_ID=local
PLAN_RUN_LEASE_SECONDS=30
PLAN_STEP_TIMEOUT_SECONDS=10
PLAN_TOTAL_TIMEOUT_SECONDS=60
PLAN_MAX_TOOL_CALLS=20
PLAN_MAX_RETRY_ATTEMPTS=5
PLAN_MAX_OUTPUT_BYTES=1048576
PLAN_MAX_QUEUED_STEPS=20
PLAN_READ_MAX_ATTEMPTS=2

# MCP 配置（第4期）
MCP_ENABLED=false
MCP_SERVER_URL=http://127.0.0.1:9123/mcp

# Multi-Agent 配置（第6期）
MULTI_AGENT_ENABLED=false

# Memory 配置（第7期）
MEMORY_ENABLED=true
MEMORY_DIR=app/sessions/memory
MEMORY_USER_ID=default
MAX_LTM_FACTS=50

# Skill 配置（第8期）
SKILLS_ENABLED=true
SKILLS_DIR=app/agent/skills/definitions

# Evaluation 配置（第9期，离线评估工具）
EVAL_DATASET_PATH=app/evaluation/cases.json
EVAL_REPORT_PATH=app/sessions/eval_report.json
EVAL_USE_JUDGE=true
EVAL_PASS_THRESHOLD=0.6

# RAG 配置（第5期）
EMBEDDING_MODEL=text-embedding-3-small
KB_DIR=app/agent/rag/knowledge
# 向量后端：numpy（手写余弦，教学透明）/ chroma（向量数据库，生产代表）
RAG_BACKEND=numpy
KB_INDEX_PATH=app/sessions/kb_index.json
CHROMA_PERSIST_DIR=app/sessions/chroma
CHROMA_COLLECTION=ecom_kb
POLICY_RAG_MIN_SCORE=0.2

# Agent 深化：售后工单 / Human-in-the-Loop
AFTER_SALE_ENABLED=true
AFTER_SALE_CASE_PATH=app/sessions/after_sale_cases.json
AFTER_SALE_OPERATION_PATH=app/sessions/after_sale_operations.json
AFTER_SALE_AUTO_APPROVE_MAX_AMOUNT=200
AFTER_SALE_HIGH_RISK_AMOUNT=2000
AFTER_SALE_OPERATION_LEASE_SECONDS=300
AFTER_SALE_OPERATION_MAX_ATTEMPTS=3
RISK_RULES_PATH=app/config/risk_rules.json
RISK_RULE_VERSIONS_PATH=app/sessions/risk_rule_versions.json

# 服务化与持久化（本地默认 SQLite；Docker Compose 使用 PostgreSQL URL）
PERSISTENCE_BACKEND=sql
DATABASE_URL=sqlite:///app/sessions/xc_sx_agent.db
# 教学环境可自动建表；production 必须关闭并使用 Alembic
# 第 24 期：已有旧库必须先执行 manage_migrations upgrade，自动建表不会升级旧工单表
DATABASE_AUTO_CREATE=true
COMMERCE_SEED_DEMO_DATA=true
API_HOST=0.0.0.0
API_PORT=8000
SESSION_DIR=app/sessions/users

# 阶段 22：认证与 Provider
AUTH_MODE=static
API_USER_TOKENS=dev-user-token:user-1
API_ADMIN_TOKENS=dev-admin-token:admin
OIDC_ISSUER=
OIDC_AUDIENCE=
OIDC_JWKS_PATH=
OIDC_REQUIRED_SCOPES=chat:use
OIDC_ALGORITHMS=RS256
OIDC_JWKS_CACHE_SECONDS=300
PROVIDER_MODE=mock
PROVIDER_TIMEOUT_SECONDS=5
PROVIDER_READ_MAX_ATTEMPTS=2
PROVIDER_WEBHOOK_SECRET=
PROVIDER_WEBHOOK_EVENTS_PATH=app/sessions/provider_webhook_events.json
API_IDEMPOTENCY_PATH=app/sessions/api_idempotency_keys.json

# API 分层限流
API_USER_REQUESTS_PER_MINUTE=120
API_ADMIN_REQUESTS_PER_MINUTE=60
API_EXPENSIVE_REQUESTS_PER_MINUTE=20

# 安全与可观测性
GUARDRAILS_ENABLED=true
MAX_USER_INPUT_CHARS=4000
BLOCK_PROMPT_INJECTION=true
OBSERVABILITY_ENABLED=true
EVENT_LOG_PATH=app/sessions/events.jsonl
EVENT_BUFFER_SIZE=1000

# 数据生命周期；清理默认 dry-run，活跃记录始终受保护
SESSION_RETENTION_DAYS=90
PLAN_RETENTION_DAYS=90
EVENT_RETENTION_DAYS=30
OPERATION_RETENTION_DAYS=365

# Policy RAG 重排与失效过滤
RAG_RERANK_ENABLED=true
RAG_FILTER_INACTIVE_POLICIES=true
RAG_LEXICAL_FALLBACK_ENABLED=true

# Stage 25: API and Worker must share SQL database and business/model configuration.
RUN_LEASE_SECONDS=30
RUN_MAX_ATTEMPTS=3
RUN_POLL_SECONDS=1

# 第26期：切换到 sandbox 前配置以下值并启动独立沙箱及退款 Worker。
# PROVIDER_MODE=sandbox；SQL 必需；演示不接真实资金；production 禁止此模式。
SANDBOX_BASE_URL=http://127.0.0.1:9124
SANDBOX_API_TOKEN=
# PROVIDER_WEBHOOK_SECRET=change-me-for-local-demo
# 沙箱进程通过 shell export 读取 SANDBOX_DATABASE_URL / SANDBOX_ADMIN_TOKEN /
# SANDBOX_CALLBACK_URL / SANDBOX_SUPPORTS_REVERSAL，不从应用 .env 读取。
